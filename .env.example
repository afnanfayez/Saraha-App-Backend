PORT=3000
DB_URI=mongodb://127.0.0.1:27017/saraha_app
SALT_ROUND=12
ENC_KEY=REPLACE_WITH_64_HEX_CHAR_ENCRYPTION_KEY
ENC_IV_LENGTH=16
ENC_ALGO=aes-256-cbc
JWT_ACCESS_USER_SECRET=REPLACE_WITH_USER_ACCESS_SECRET
JWT_REFRESH_USER_SECRET=REPLACE_WITH_USER_REFRESH_SECRET
JWT_ACCESS_ADMIN_SECRET=REPLACE_WITH_ADMIN_ACCESS_SECRET
JWT_REFRESH_ADMIN_SECRET=REPLACE_WITH_ADMIN_REFRESH_SECRET
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800
GOOGLE_CLIENT_ID=PUT_YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com
