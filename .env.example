NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/saraha_app
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ISSUER=saraha-app
JWT_AUDIENCE=saraha-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
ENCRYPTION_KEY_VERSION=v1
ENCRYPTION_KEY=base64-encoded-32-byte-key
# Optional JSON map of old key versions to base64-encoded 32-byte keys for decrypting older messages.
ENCRYPTION_OLD_KEYS=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
MESSAGE_RATE_LIMIT_MAX=20
# development: console, test: memory, production: resend
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
RESEND_API_KEY=replace-with-resend-api-key
APP_BASE_URL=http://localhost:3000
# Set true in production when a verified email is required before login.
REQUIRE_EMAIL_VERIFICATION=true
AVATAR_UPLOAD_DIR=uploads/avatars
AVATAR_MAX_SIZE_BYTES=2097152
